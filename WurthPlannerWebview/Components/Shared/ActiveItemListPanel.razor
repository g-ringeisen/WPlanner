@namespace WurthPlannerWebview.Components.Shared
@using WurthPlanner.Models

<section>
    <h2 class="h5">À traiter</h2>
    @if (Items.Count == 0)
    {
        <p class="text-muted">Rien à traiter pour le moment.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in Items)
            {
                <button type="button" class="list-group-item list-group-item-action" @onclick="() => OnItemSelected.InvokeAsync(item.Id)">
                    <strong>@item.Title</strong><br />
                    <small>@item.Type · @StatusLabel(item.Status)</small>
                </button>
            }
        </div>
    }
</section>

@code {
    // Les dates et les personnes sont désormais portées par Assignment, pas WorkItem.
    [Parameter] public IReadOnlyCollection<IWorkItemBrief> Items { get; set; } = Array.Empty<IWorkItemBrief>();
    [Parameter] public EventCallback<Guid> OnItemSelected { get; set; }

    private static string StatusLabel(WorkItemStatus status) => status switch
    {
        WorkItemStatus.Open => "À faire",
        WorkItemStatus.InProgress => "En cours",
        WorkItemStatus.Closed => "Terminé",
        WorkItemStatus.Cancelled => "Annulé",
        _ => status.ToString()
    };
}
