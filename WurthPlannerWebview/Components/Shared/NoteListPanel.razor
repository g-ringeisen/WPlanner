@namespace WurthPlannerWebview.Components.Shared
@using WurthPlanner.Models

<div class="list-group">
    @foreach (var item in FilteredItems)
    {
        <button type="button" class="list-group-item list-group-item-action @(item.Id == SelectedWorkItemId ? "active" : string.Empty)" @onclick="() => OnWorkItemSelected.InvokeAsync(item.Id)">
            <strong>@item.Title</strong><br />
            <small>@item.Excerpt</small>
        </button>
    }
</div>

@code {
    [Parameter] public IReadOnlyCollection<IWorkItemBrief> WorkItems { get; set; } = Array.Empty<IWorkItemBrief>();
    [Parameter] public Guid? SelectedWorkItemId { get; set; }
    [Parameter] public EventCallback<Guid> OnWorkItemSelected { get; set; }
    private IEnumerable<IWorkItemBrief> FilteredItems => WorkItems.OrderByDescending(item => item.Id);
}
