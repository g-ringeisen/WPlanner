@namespace WurthPlannerWebview.Components.Shared
@using WurthPlanner.Contracts.Planning

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead><tr><th>Personne</th><th>Élément</th><th>Du</th><th>Au</th><th>Charge prévue</th></tr></thead>
        <tbody>
            @foreach (var assignment in Assignments.OrderBy(item => item.Assignment.AssigneeId).ThenBy(item => item.Assignment.StartDate))
            {
                <tr>
                    <td>@(assignment.Assignment.AssigneeId ?? "Non affecté")</td>
                    <td>@assignment.WorkItem.Title</td>
                    <td>@assignment.Assignment.StartDate?.ToString("dd/MM/yyyy")</td>
                    <td>@assignment.Assignment.EndDate?.ToString("dd/MM/yyyy")</td>
                    <td>@assignment.Assignment.PlannedDays?.ToString()</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    // Une barre représente maintenant un PlannedAssignmentResult et non un WorkItem.
    [Parameter] public IReadOnlyCollection<PlannedAssignmentResult> Assignments { get; set; } = Array.Empty<PlannedAssignmentResult>();
}
